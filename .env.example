# Public base URL of the running app. No trailing slash.
APP_BASE_URL="https://your-demo-domain.example"

# Solari Browser
SOLARI_API_KEY="slr_live_..."

# Gemini (used by /operations demo)
GEMINI_API_KEY=""

# Google OAuth / Auth.js
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_SECRET=""
AUTH_URL="https://your-demo-domain.example"
AUTH_TRUST_HOST="true"

# Email address allowed to view /admin/feedback
ADMIN_EMAIL=""

# PostgreSQL for persistent demo users, investigation cases and feedback
# Use the pooled URL for the running app and the direct URL for Prisma schema operations.
DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."
